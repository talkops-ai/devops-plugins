{
  "mcpServers": {
    "helm": {
      "command": "uvx",
      "args": [
        "--from",
        "talkops-helm-mcp-server==0.5.1",
        "helm-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "MCP_ALLOW_WRITE": "${MCP_ALLOW_WRITE:-false}"
      }
    },
    "argocd": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/scripts/launch_argocd_mcp.py",
        "--from",
        "talkops-argocd-mcp-server==0.4.1",
        "argocd-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "MCP_ALLOW_WRITE": "${MCP_ALLOW_WRITE:-false}"
      }
    },
    "argo-rollout": {
      "command": "uvx",
      "args": [
        "--from",
        "talkops-argo-rollout-mcp-server==0.2.1",
        "argo-rollout-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "MCP_ALLOW_WRITE": "${MCP_ALLOW_WRITE:-false}"
      }
    },
    "kargo": {
      "command": "uvx",
      "args": [
        "--from",
        "talkops-kargo-mcp-server==0.2.1",
        "kargo-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "MCP_ALLOW_WRITE": "${MCP_ALLOW_WRITE:-false}"
      }
    },
    "traefik": {
      "command": "uvx",
      "args": [
        "--from",
        "talkops-traefik-mcp-server==0.2.1",
        "traefik-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "MCP_ALLOW_WRITE": "${MCP_ALLOW_WRITE:-false}"
      }
    }
  }
}
