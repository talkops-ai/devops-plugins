{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "aws-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws-cli==1.7.0",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--skip-auth",
        "--metadata",
        "INSTALL_SOURCE=agent-toolkit-iac"
      ]
    },
    "awsiac": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--with",
        "fastmcp<4.0.0",
        "awslabs.aws-iac-mcp-server==0.2.14"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "terraform": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "ENABLE_TF_OPERATIONS=false",
        "-e",
        "TFE_TOKEN",
        "-e",
        "TFE_ADDRESS",
        "hashicorp/terraform-mcp-server:1"
      ]
    },
    "pulumi": {
      "type": "streamable-http",
      "url": "https://mcp.ai.pulumi.com/mcp"
    }
  }
}
