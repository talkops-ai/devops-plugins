{
  "mcpServers": {
    "prometheus": {
      "command": "uvx",
      "args": [
        "--from",
        "talkops-prometheus-mcp-server==0.2.1",
        "prometheus-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "MCP_ALLOW_WRITE": "${MCP_ALLOW_WRITE:-false}"
      }
    },
    "alertmanager": {
      "command": "uvx",
      "args": [
        "--from",
        "talkops-alertmanager-mcp-server==0.2.1",
        "alertmanager-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "MCP_ALLOW_WRITE": "${MCP_ALLOW_WRITE:-false}"
      }
    },
    "tempo": {
      "command": "uvx",
      "args": [
        "--from",
        "talkops-tempo-mcp-server==0.2.1",
        "tempo-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "MCP_ALLOW_WRITE": "${MCP_ALLOW_WRITE:-false}"
      }
    },
    "loki": {
      "command": "uvx",
