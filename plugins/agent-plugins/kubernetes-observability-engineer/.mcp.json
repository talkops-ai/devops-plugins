        "--from",
        "talkops-loki-mcp-server==0.2.1",
        "loki-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "MCP_ALLOW_WRITE": "${MCP_ALLOW_WRITE:-false}"
      }
    },
    "opentelemetry": {
      "command": "uvx",
      "args": [
        "--from",
        "talkops-opentelemetry-mcp-server==0.2.1",
        "opentelemetry-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "MCP_ALLOW_WRITE": "${MCP_ALLOW_WRITE:-false}"
      }
    }
  }
}
